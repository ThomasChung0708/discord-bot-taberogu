DISCORD_TOKEN=your_discord_bot_token
OPENAI_API_KEY=your_openai_api_key
# Official GPT-4.x migration starts at none; gpt-4.1-mini shuts down 2027-01-14.
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=none
DB_PATH=restaurants.sqlite3
GOOGLE_SHEETS_ID=your_google_sheet_id
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_SHEETS_WORKSHEET=restaurants
GOOGLE_MY_MAPS_URL=your_google_my_maps_share_url
ADMIN_PASSWORD=your_admin_panel_password
# Persistent random secret: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
PUBLIC_WEB_URL=http://your_vm_external_ip:8000/
PUBLIC_MAP_URL=https://discord-bottaberogudb.org/map
AUTO_SAVE_RESTAURANT_LINKS=true
ALLOWED_TEXT_CHANNEL_NAMES=食べログ
ALLOWED_TEXT_CHANNEL_IDS=
CHAT_MEMORY_ENABLED=true
CHAT_MEMORY_RAW_LIMIT=100
CHAT_MEMORY_SUMMARY_BATCH=50
CHAT_MEMORY_MAX_MESSAGE_CHARS=800
